<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>

	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Stitch collects nothing. The image never leaves the device: it is read from the
	     clipboard or a file the user picks, edited in memory, and written back only where the
	     user asks. There is no networking code in the app. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- Stitch calls none of the required-reason APIs directly: no UserDefaults, no file
	     timestamps, no disk-space queries, no active-keyboard queries. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
